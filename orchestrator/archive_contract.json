{
  "schema_version": "2.1",
  "archive_name_pattern": "{company_display_name}_환경자료",
  "roots": {
    "INDEX": "00_자료목록",
    "USER": "01_사용자자료",
    "SYSTEM_RAW": "90_시스템원본"
  },
  "user_folders": {
    "CLEANSYS_AIR": "01_사용자자료/01_TMS/대기_CleanSYS",
    "SOOSIRO_WATER": "01_사용자자료/01_TMS/수질_SOOSIRO",
    "PRTR": "01_사용자자료/02_화학물질/PRTR_배출이동량",
    "CHEM_STATS": "01_사용자자료/02_화학물질/화학물질통계",
    "ENVINFO": "01_사용자자료/03_환경정보공개시스템",
    "SUSTAINABILITY_REPORT": "01_사용자자료/04_지속가능경영보고서",
    "ANNUAL_REPORT": "01_사용자자료/05_사업보고서_공시",
    "ENVIRONMENTAL_DISCLOSURE": "01_사용자자료/05_사업보고서_공시",
    "ENVIRONMENTAL_POLICY": "01_사용자자료/06_회사환경정책/환경경영",
    "CHEMICAL_POLICY": "01_사용자자료/06_회사환경정책/화학물질관리",
    "CLIMATE_ENERGY_POLICY": "01_사용자자료/06_회사환경정책/기후에너지",
    "SHE_POLICY": "01_사용자자료/06_회사환경정책/환경안전보건",
    "CERTIFICATION": "01_사용자자료/06_회사환경정책/인증_ISO",
    "GUIDELINE": "01_사용자자료/07_가이드라인_참고자료/업종별_가이드라인",
    "BAT_REFERENCE": "01_사용자자료/07_가이드라인_참고자료/BAT_기준서",
    "REGULATION_REFERENCE": "01_사용자자료/07_가이드라인_참고자료/법령_제도"
  },
  "acceptance": {
    "structured_sources_require_user_xlsx": ["CLEANSYS_AIR", "SOOSIRO_WATER", "PRTR", "CHEM_STATS"],
    "required_user_exports": {
      "CLEANSYS_AIR": "01_사용자자료/01_TMS/대기_CleanSYS/CleanSYS_대기TMS_정리.xlsx",
      "SOOSIRO_WATER": "01_사용자자료/01_TMS/수질_SOOSIRO/SOOSIRO_수질TMS_정리.xlsx",
      "PRTR": "01_사용자자료/02_화학물질/PRTR_배출이동량/PRTR_화학물질배출이동량_정리.xlsx",
      "CHEM_STATS": "01_사용자자료/02_화학물질/화학물질통계/화학물질통계_정리.xlsx"
    },
    "envinfo_confirmed_site_year_requires_pdf": true,
    "minimum_sustainability_reports": 5,
    "sustainability_series_must_be_shallow": true,
    "sustainability_filename_requires_year": true,
    "user_layer_prohibited_extensions": [".html", ".htm", ".json", ".jsonl"],
    "review_user_extensions": [".pdf", ".xlsx"],
    "validate_pdf_integrity": true,
    "validate_xlsx_integrity": true,
    "public_policy_required": true,
    "guideline_reference_required": true
  },
  "delivery": {
    "policy": "EXACT_ARCHIVE_OR_BYTE_PRESERVING_VALIDATED_SUBSET_ONLY",
    "source_archive_must_pass_acceptance": true,
    "source_archive_sha256_required": true,
    "repacked_member_bytes_must_equal_source": true,
    "manual_repackaging_after_acceptance": "PROHIBITED"
  },
  "principles": [
    "A user must be able to conduct ordinary research and comparison without opening 90_시스템원본.",
    "Raw HTML, JSON, JSONL, collector logs and control-plane evidence are isolated under 90_시스템원본.",
    "Publicly readable source documents and user-friendly structured exports are placed under 01_사용자자료.",
    "Single-document annual series such as sustainability reports remain in one shallow folder with the year in the filename.",
    "Site-year folders are used only where multiple documents per site/year make the extra hierarchy useful.",
    "Missing, blocked or ambiguous material is explicit REVIEW_REQUIRED and prevents a false COMPLETE claim.",
    "Human-facing copies never replace source-native raw artifacts and every copied file remains traceable to evidence.",
    "The artifact delivered to a user must be the accepted Human Archive itself or a verified byte-preserving subset derived from it; ad-hoc repackaging after acceptance is not a valid delivery path."
  ]
}
